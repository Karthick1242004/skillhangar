{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "skill-scanner",
          "version": "1.0.0",
          "informationUri": "https://github.com/cisco-ai-defense/skill-scanner",
          "rules": [
            {
              "id": "MANIFEST_MISSING_LICENSE",
              "name": "Manifest Missing License",
              "shortDescription": {
                "text": "Skill does not specify a license"
              },
              "fullDescription": {
                "text": "Skill manifest does not include a 'license' field. Specifying a license helps users understand usage terms."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "category": "policy_violation",
                "severity": "INFO",
                "tags": [
                  "policy_violation",
                  "security"
                ]
              },
              "help": {
                "text": "Add 'license' field to SKILL.md frontmatter (e.g., MIT, Apache-2.0)",
                "markdown": "**Remediation**: Add 'license' field to SKILL.md frontmatter (e.g., MIT, Apache-2.0)"
              }
            },
            {
              "id": "CORRELATED_NETWORK_EXECUTION_FLOW",
              "name": "Correlated Network Execution Flow",
              "shortDescription": {
                "text": "Network-derived content reaches code execution"
              },
              "fullDescription": {
                "text": "Correlated network \u2192 code_execution behavior across scripts/setup.sh."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "category": "command_injection",
                "severity": "HIGH",
                "tags": [
                  "command_injection",
                  "security"
                ]
              },
              "help": {
                "text": "Verify downloaded content cryptographically and never pass network data to a dynamic interpreter.",
                "markdown": "**Remediation**: Verify downloaded content cryptographically and never pass network data to a dynamic interpreter."
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "MANIFEST_MISSING_LICENSE",
          "level": "note",
          "message": {
            "text": "Skill manifest does not include a 'license' field. Specifying a license helps users understand usage terms."
          },
          "properties": {
            "category": "policy_violation",
            "severity": "INFO",
            "remediation": "Add 'license' field to SKILL.md frontmatter (e.g., MIT, Apache-2.0)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mal-pipe-shell/SKILL.md",
                  "uriBaseId": "%SRCROOT%"
                }
              }
            }
          ],
          "fingerprints": {
            "primaryLocationLineHash": "MANIFEST_MISSING_LICENSE_c5ae9be793"
          }
        },
        {
          "ruleId": "CORRELATED_NETWORK_EXECUTION_FLOW",
          "level": "error",
          "message": {
            "text": "Correlated network \u2192 code_execution behavior across scripts/setup.sh."
          },
          "properties": {
            "category": "command_injection",
            "severity": "HIGH",
            "remediation": "Verify downloaded content cryptographically and never pass network data to a dynamic interpreter.",
            "aitech": "AITech-9.1",
            "aisubtech": "AISubtech-9.1.1",
            "framework_mappings": [
              "OWASP: LLM04:2026: Supply Chain",
              "OWASP: ASI04: Agentic Supply Chain Vulnerabilities",
              "OWASP: ASI05: Unexpected Code Execution (RCE)",
              "MITRE ATLAS: AML.T0050: Command and Scripting Interpreter",
              "NIST AML: NISTAML.023: Backdoor Poisoning"
            ],
            "aitech_mappings": [
              "OWASP: LLM04:2026: Supply Chain",
              "OWASP: ASI04: Agentic Supply Chain Vulnerabilities",
              "OWASP: ASI05: Unexpected Code Execution (RCE)",
              "MITRE ATLAS: AML.T0050: Command and Scripting Interpreter",
              "NIST AML: NISTAML.023: Backdoor Poisoning",
              "Cisco AI MDL Code: MDL-006",
              "Cisco AI MDL Code: MDL-007",
              "Cisco AI MDL Code: MDL-005",
              "Cisco AI MDL Code: MDL-010",
              "Cisco AI MDL Code: MDL-012",
              "Cisco AI MDL Code: MDL-014",
              "Cisco AI MDL Code: MDL-015",
              "Cisco AI MDL Code: MDL-019"
            ],
            "aisubtech_mappings": [
              "OWASP: LLM04:2026: Supply Chain",
              "OWASP: ASI04: Agentic Supply Chain Vulnerabilities",
              "OWASP: ASI05: Unexpected Code Execution (RCE)",
              "MITRE ATLAS: AML.T0050: Command and Scripting Interpreter",
              "NIST AML: NISTAML.023: Backdoor Poisoning"
            ]
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mal-pipe-shell/scripts/setup.sh",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ],
          "fingerprints": {
            "primaryLocationLineHash": "CORRELATED_NETWORK_EXECUTION_FLOW_5f9a48a9875f"
          }
        }
      ],
      "invocations": [
        {
          "executionSuccessful": true,
          "endTimeUtc": "2026-11-13T12:26:46Z"
        }
      ]
    }
  ]
}