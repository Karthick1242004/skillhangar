{
  "name": "skillhangar",
  "version": "0.1.0",
  "description": "Local dashboard to inventory, audit, install and update Claude Code skills, plugins and MCP servers.",
  "keywords": [
    "claude-code",
    "skills",
    "mcp",
    "agent-skills",
    "security",
    "audit"
  ],
  "homepage": "https://github.com/Karthick1242004/skillhangar#readme",
  "bugs": {
    "url": "https://github.com/Karthick1242004/skillhangar/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karthick1242004/skillhangar.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "skillhangar": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build:ui && npm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "dev:server": "node scripts/build-server.mjs --watch",
    "dev:ui": "vite --config ui/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "diff": "9.0.0",
    "hono": "4.13.18",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "esbuild": "0.28.2",
    "gsap": "3.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wouter": "3.13.0"
  }
}
